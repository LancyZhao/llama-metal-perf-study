@@ -313,6 +313,26 @@ static bool ggml_metal_library_flatten_file(NSMutableString * dst, NSString * pa
 // *err set on failure. On success the objs[] slots are populated and the routing
 // index is built; on any failure every error is logged and false is returned
 // (the caller is responsible for freeing `res`).
+// comma-separated exact-token membership test (used by GGML_METAL_SKIP_LIBS)
+static bool ggml_metal_name_in_csv(const char * csv, const char * name) {
+    if (!csv || !name) {
+        return false;
+    }
+    const size_t n = strlen(name);
+    for (const char * p = csv; *p; ) {
+        const char * e = strchr(p, ',');
+        const size_t len = e ? (size_t) (e - p) : strlen(p);
+        if (len == n && strncmp(p, name, n) == 0) {
+            return true;
+        }
+        if (!e) {
+            break;
+        }
+        p = e + 1;
+    }
+    return false;
+}
